generator client {
    provider      = "prisma-client-js"
    output        = "../../lib/generated/aiuvl"
    binaryTargets = ["native"]
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL_AIUVL")
}

enum Permissao {
    DEV
    ADM
    USR
}

enum TipoUsuario {
    INTERNO
    EXTERNO
}

enum Segmento {
    ONG
    ASSOCIACAO_BAIRRO
    ENTIDADE_ACADEMICA
    REP_EMPRESARIAL
}

enum TipoInscricao {
    CANDIDATO
    ELEITOR
}

enum TipoCandidato {
    TITULAR
    SUPLENTE
}

enum Genero {
    MASCULINO
    FEMININO
    OUTRO
}

enum Status {
    EM_ANALISE
    DEFERIDO
    INDEFERIDO
}

enum CategoriaArquivo {
    // Candidatura - documentos da entidade
    CAND_ENT_REQUERIMENTO
    CAND_ENT_DECLARACAO_ATUACAO
    CAND_ENT_ESTATUTO
    CAND_ENT_ATA_ELEICAO
    CAND_ENT_CNPJ
    CAND_ENT_DECLARACAO_IDONEIDADE
    // Candidatura - documentos do representante legal da entidade
    CAND_REP_IDENTIDADE
    CAND_REP_CPF
    CAND_REP_TITULO_ELEITOR
    CAND_REP_COMPROVANTE_RESIDENCIA
    // Candidatura - documentos dos candidatos (titular/suplente) via candidatoId
    CAND_CAN_IDENTIDADE
    CAND_CAN_CPF
    CAND_CAN_FOTO
    CAND_CAN_TITULO_ELEITOR
    CAND_CAN_COMPROVANTE_RESIDENCIA
    CAND_CAN_DECLARACAO
    // Eleitor - documentos da entidade
    ELEIT_ENT_REQUERIMENTO
    ELEIT_ENT_DECLARACAO_ATUACAO
    ELEIT_ENT_ESTATUTO
    ELEIT_ENT_ATA_ELEICAO
    ELEIT_ENT_CNPJ
    ELEIT_ENT_DECLARACAO_IDONEIDADE
    // Eleitor - documentos do representante legal
    ELEIT_REP_IDENTIDADE
    ELEIT_REP_CPF
    ELEIT_REP_TITULO_ELEITOR
    ELEIT_REP_COMPROVANTE_RESIDENCIA
    // Documentação complementar
    COMPLEMENTAR
}

model Usuario {
    id             String      @id @default(uuid())
    tipo           TipoUsuario @default(INTERNO)
    nome           String
    email          String      @unique
    login          String?     @unique
    permissao      Permissao?
    status         Boolean     @default(true)
    senha          String?
    primeiroAcesso Boolean     @default(true)
    criadoEm      DateTime    @default(now())
    atualizadoEm  DateTime    @default(now()) @updatedAt

    candidaturas Candidatura[]
    eleitor      Eleitor?

    @@map("usuarios")
}

model Candidatura {
    id                  String        @id @default(uuid())
    tipoInscricao       TipoInscricao
    status              Status        @default(EM_ANALISE)
    oculto              Boolean       @default(false)
    motivoIndeferimento String?       @db.Text
    rodada              Int           @default(1)
    usuarioId           String
    criadoEm           DateTime      @default(now())
    atualizadoEm       DateTime      @default(now()) @updatedAt

    usuario     Usuario              @relation(fields: [usuarioId], references: [id])
    organizacao OrganizacaoCandidata?
    candidatos  Candidato[]
    arquivos    Arquivo[]

    @@unique([usuarioId, rodada])
    @@map("candidaturas")
}

model OrganizacaoCandidata {
    id            String   @id @default(uuid())
    razaoSocial   String
    cnpj          String
    segmento      Segmento
    dataAbertura  DateTime @db.Date
    sede          String
    repNome       String
    repCpf        String
    repTituloEleitor String?
    repDomicilio  String?
    emailEntidade String
    telefone      String?
    candidaturaId String   @unique
    criadoEm     DateTime @default(now())
    atualizadoEm DateTime @default(now()) @updatedAt

    candidatura Candidatura @relation(fields: [candidaturaId], references: [id])
    arquivos    Arquivo[]

    @@map("organizacoes_candidatas")
}

model Candidato {
    id                 String        @id @default(uuid())
    tipoCandidato      TipoCandidato
    nome               String
    nomeSocial         String?
    genero             Genero
    dataNascimento     DateTime      @db.Date
    cpf                String
    tituloEleitor      String?
    domicilioEleitoral String?
    email              String
    telefone           String?
    candidaturaId      String
    criadoEm          DateTime      @default(now())
    atualizadoEm      DateTime      @default(now()) @updatedAt

    candidatura Candidatura @relation(fields: [candidaturaId], references: [id])
    arquivos    Arquivo[]

    @@unique([cpf, candidaturaId])
    @@map("candidatos")
}

model Eleitor {
    id                  String   @id @default(uuid())
    status              Status   @default(EM_ANALISE)
    oculto              Boolean  @default(false)
    motivoIndeferimento String?  @db.Text
    usuarioId           String?  @unique
    criadoEm           DateTime @default(now())
    atualizadoEm       DateTime @default(now()) @updatedAt

    usuario     Usuario?             @relation(fields: [usuarioId], references: [id])
    organizacao OrganizacaoEleitora?
    arquivos    Arquivo[]

    @@map("eleitores")
}

model OrganizacaoEleitora {
    id               String   @id @default(uuid())
    razaoSocial      String
    cnpj             String   @unique
    segmento         Segmento
    segmentoVotacao  Segmento
    dataAbertura     DateTime @db.Date
    sede             String
    repNome          String
    repCpf           String
    repTituloEleitor String?
    repDomicilio     String?
    emailEntidade    String
    telefone         String?
    eleitorId        String   @unique
    criadoEm        DateTime @default(now())
    atualizadoEm    DateTime @default(now()) @updatedAt

    eleitor  Eleitor   @relation(fields: [eleitorId], references: [id])
    arquivos Arquivo[]

    @@map("organizacoes_eleitoras")
}

model Arquivo {
    id             String           @id @default(uuid())
    nome           String
    tipo           String
    tamanho        Int
    caminho        String           @db.Text
    categoria      CategoriaArquivo
    candidaturaId  String?
    candidatoId    String?
    orgCandidataId String?
    eleitorId      String?
    orgEleitoraId  String?
    criadoEm      DateTime         @default(now())
    atualizadoEm  DateTime         @default(now()) @updatedAt

    candidatura  Candidatura?          @relation(fields: [candidaturaId], references: [id])
    candidato    Candidato?            @relation(fields: [candidatoId], references: [id])
    orgCandidata OrganizacaoCandidata? @relation(fields: [orgCandidataId], references: [id])
    eleitor      Eleitor?              @relation(fields: [eleitorId], references: [id])
    orgEleitora  OrganizacaoEleitora?  @relation(fields: [orgEleitoraId], references: [id])

    @@map("arquivos")
}
